<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # CRITICAL: Define the base path, including the final slash.
    RewriteBase /flightphp_project/backend/

    # Do not rewrite if the request is for an existing file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite everything else to index.php, appending the path info for Flight
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>